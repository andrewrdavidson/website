### Hugo ###
# Generated files by hugo
/public/
/resources/_gen/
/assets/jsconfig.json
hugo_stats.json

# Executable may be added to repository
hugo.exe
hugo.darwin
hugo.linux

# Temporary lock file while building
/.hugo_build.lock

# node modules
node_modules/
node_modules/.package-lock.json

# Playwright: failure traces and the HTML report
test-results/
playwright-report/

# Development scratch: dev-server and verification logs, throwaway probe scripts, and the
# .tmp-search/ helper an early session used. One pattern rather than a list of the files that
# happened to exist when this was written.
.tmp-*
.freebuff/
